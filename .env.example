# AzothBot environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must stay
# that way — SUPABASE_KEY on the deployed bot is the service-role key.
#
# See docs/DEPLOYMENT.md for where each value comes from.

# --- Discord ---------------------------------------------------------------

# Bot token from the Discord Developer Portal → your app → Bot → Reset Token.
DISCORD_TOKEN=

# Snowflake ID of the guild (server) slash commands register to.
# Every command in this bot is guild-scoped to this ID — see docs/ARCHITECTURE.md
# § Command registration. Enable Developer Mode in Discord, then right-click the
# server → Copy Server ID.
DEV_GUILD_ID=

# Comma-separated Discord user IDs allowed to run mutating commands.
# THIS IS THE SECURITY BOUNDARY. The deployed bot holds a service-role key, so
# anyone on this list can create, overwrite, and delete production content.
# Right-click a user → Copy User ID.
AUTHORIZED_USER_IDS=111111111111111111,222222222222222222

# --- Supabase --------------------------------------------------------------

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# API key. WHICH KEY YOU USE CHANGES WHAT THE BOT CAN SEE:
#
#   service_role  — full read/write, bypasses RLS. What the deployed bot uses.
#                   Required for /stats: the turn-grain tables are INSERT-only
#                   for anon and return ZERO ROWS (not an error) without it.
#
#   anon          — the same key shipped inside the game binary. Reads a subset
#                   of content tables and nothing else. Safe for local work on
#                   rendering or command plumbing, but analytics will silently
#                   look empty.
#
# See docs/DB_SCHEMA.md § Which key you are holding.
SUPABASE_KEY=

# Players row id the bot writes as `created_by` on content it creates.
BOT_PLAYER_ID=
